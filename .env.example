# =========================================
# DEFOCO - SISTEMA DE GESTÃO
# Arquivo de Configuração de Ambiente
# =========================================

# ===== BANCO DE DADOS (OBRIGATÓRIO) =====
DATABASE_URL="postgresql://defoco_user:sua_senha_forte@localhost:5432/defoco_db"

# ===== AUTENTICAÇÃO (OBRIGATÓRIO) =====
# URL completa do seu site (sem barra no final)
NEXTAUTH_URL="https://seu-dominio.com.br"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="gere_uma_string_aleatoria_de_32_caracteres"

# ===== AWS S3 (OPCIONAL - para upload de arquivos) =====
AWS_REGION="sa-east-1"
AWS_BUCKET_NAME="seu-bucket-s3"
AWS_ACCESS_KEY_ID="sua_access_key"
AWS_SECRET_ACCESS_KEY="sua_secret_key"
AWS_FOLDER_PREFIX="defoco/"

# ===== NOTIFICAÇÕES EMAIL (OPCIONAL) =====
# IDs gerados pelo serviço de notificação
WEB_APP_ID=""
NOTIF_ID_PROPOSTA_APROVADA=""
NOTIF_ID_PROPOSTA_REJEITADA=""
NOTIF_ID_JOB_ATRIBUDO=""

# ===== LLM API (OPCIONAL - para análise com IA) =====
ABACUSAI_API_KEY=""
